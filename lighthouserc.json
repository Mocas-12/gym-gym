{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4174 --strictPort",
      "startServerReadyPattern": "Local",
      "url": ["http://localhost:4174/"],
      "numberOfRuns": 1,
      "settings": {
        "skipAudits": ["uses-http2", "canonical", "robots-txt"],
        "note": "robots-txt/canonical 对 GitHub Pages 项目页（/gym-gym/ 子路径）不可控，跳过"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "coverage/lighthouse" }
  }
}
